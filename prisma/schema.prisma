generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ── Usuarios y roles ──────────────────────────────────────────────
// ADMIN: acceso total. SUPERVISOR: puede registrar mediciones, fotos,
// incumplimientos y cambiar estados. LECTURA: solo consulta.
// EXPOSITOR: solo ve y sube renders/planos de SU espacio (espacioId).
model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          String   @default("LECTURA")
  activo       Boolean  @default(true)
  espacioId    String?  @unique // solo para rol EXPOSITOR: su stand asignado
  createdAt    DateTime @default(now())

  espacio Espacio? @relation("EspacioUsuario", fields: [espacioId], references: [id], onDelete: SetNull)
  espaciosSupervisados Espacio[] @relation("EspacioSupervisor")
  actividadesCreadas   EventoActividad[]

  mediciones       Medicion[]
  incumplimientosCerrados Incumplimiento[] @relation("IncumplimientoCerradoPor")
  visitas          VisitaProgramada[]
  versionesSubidas   VersionEntrega[] @relation("VersionSubidaPor")
  versionesRevisadas VersionEntrega[] @relation("VersionRevisadaPor")
  comentarios        ComentarioEspacio[]
  responsablesCronograma Responsable[]
  tareaProyectoLogs      TareaProyectoLog[]

  @@map("usuarios")
}

// ── El evento/feria que se está supervisando ─────────────────────
model Evento {
  id              String   @id @default(cuid())
  nombre          String
  recinto         String?
  fechaInicio     DateTime
  fechaFin        DateTime
  montajeInicio   DateTime?
  montajeFin      DateTime?
  desmontajeInicio DateTime?
  desmontajeFin   DateTime?
  pausaInicio     DateTime? // días cerrado al público en medio del evento (ej. entre dos tandas de apertura)
  pausaFin        DateTime?
  horariosNota    String?   // texto libre con el horario de atención al público
  planoUrl        String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())

  espacios       Espacio[]
  actividades    EventoActividad[]
  invitados      Invitado[]
  etapasInvitado EtapaInvitado[]
  categoriasProyecto   CategoriaProyecto[]
  responsablesProyecto Responsable[]
  tareasProyecto       TareaProyecto[]

  @@map("eventos")
}

// ── CRM de invitados: etapas personalizadas (el organizador define
// las que necesite, ej. "Contactado", "Confirmado", "No asistirá") ──
model EtapaInvitado {
  id       String @id @default(cuid())
  eventoId String
  nombre   String
  orden    Int    @default(0)

  evento    Evento     @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  invitados Invitado[]

  @@unique([eventoId, nombre])
  @@map("etapas_invitado")
}

model Invitado {
  id        String   @id @default(cuid())
  eventoId  String
  nombre    String
  empresa   String?
  telefono  String?
  correo    String?
  notas     String?
  etapaId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evento Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  etapa  EtapaInvitado? @relation(fields: [etapaId], references: [id], onDelete: SetNull)

  @@map("invitados")
}

// ── Reuniones y otras actividades sueltas del cronograma ──────────
// (a diferencia de las fechas fijas del evento: montaje, apertura, etc.)
model EventoActividad {
  id          String   @id @default(cuid())
  eventoId    String
  titulo      String
  fecha       DateTime
  hora        String? // "14:00", opcional
  tipo        String   @default("REUNION") // REUNION | OTRO
  descripcion String?
  creadoPorId String?
  createdAt   DateTime @default(now())

  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  creadoPor Usuario? @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@map("evento_actividades")
}

// ── Cronograma de proyecto: categorías personalizadas por evento (ej.
// "Local", "Presupuesto", "Reglamento"...). Mismo patrón que EtapaInvitado:
// el organizador las administra; se seedean 10 por defecto al crear el
// evento pero ADMIN puede renombrar/agregar/borrar después.
model CategoriaProyecto {
  id       String @id @default(cuid())
  eventoId String
  nombre   String
  orden    Int    @default(0)

  evento Evento          @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  tareas TareaProyecto[]

  @@unique([eventoId, nombre])
  @@map("categorias_proyecto")
}

// ── Cronograma de proyecto: catálogo de responsables por evento. Puede ser
// una persona/entidad sin cuenta (ej. "AGENCIA", "COMITÉ" — solo ADMIN o
// SUPERVISOR editan sus tareas) o estar ligado a un Usuario real (esa
// persona puede entonces actualizar progreso/observaciones de SUS tareas
// aunque no tenga rol Admin/Supervisor).
model Responsable {
  id        String  @id @default(cuid())
  eventoId  String
  nombre    String
  iniciales String?
  area      String?
  usuarioId String?

  evento  Evento          @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tareas  TareaProyecto[]

  @@unique([eventoId, nombre])
  @@unique([eventoId, usuarioId])
  @@map("responsables_proyecto")
}

// ── Cronograma de proyecto: la actividad del plan. fechaFin y estado se
// recalculan en el servidor en cada escritura (ver lib/cronograma.ts) —
// nunca se editan directo desde el cliente.
model TareaProyecto {
  id            String   @id @default(cuid())
  eventoId      String
  categoriaId   String
  responsableId String?
  nombre        String
  fechaInicio   DateTime
  duracionDias  Int      @default(1)
  fechaFin      DateTime // calculado: fechaInicio + duracionDias - 1
  progreso      Int      @default(0) // 0-100
  estado        String   @default("NO_INICIADA") // NO_INICIADA | EN_CURSO | COMPLETADA | ATRASADA (calculado)
  esHito        Boolean  @default(false)
  observaciones String?
  adjuntos      String[] @default([]) // URLs de guardarArchivo/subirArchivoCliente
  orden         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evento      Evento             @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  categoria   CategoriaProyecto  @relation(fields: [categoriaId], references: [id])
  responsable Responsable?       @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  historial   TareaProyectoLog[]

  @@map("tareas_proyecto")
}

// ── Cronograma de proyecto: bitácora de cambios de cada tarea, para el
// panel de detalle (quién cambió qué campo y cuándo).
model TareaProyectoLog {
  id            String   @id @default(cuid())
  tareaId       String
  usuarioId     String?
  campo         String // "progreso" | "estado" | "fechaInicio" | "duracionDias" | "responsableId" | "categoriaId" | "observaciones"
  valorAnterior String?
  valorNuevo    String?
  fecha         DateTime @default(now())

  tarea   TareaProyecto @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  usuario Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("tareas_proyecto_log")
}

// ── Grupo/distribuidor que representa la marca (ej. Autos Xtra) ──
model Distribuidor {
  id     String @id @default(cuid())
  nombre String @unique

  espacios Espacio[]

  @@map("distribuidores")
}

// ── Empresa constructora del stand (ej. LARTI 3D) ─────────────────
model ProveedorConstructor {
  id       String @id @default(cuid())
  nombre   String @unique
  contacto String?
  telefono String?

  espacios         Espacio[]
  incumplimientos  Incumplimiento[]

  @@map("proveedores_constructores")
}

// ── Espacio: stand automotriz o módulo financiero ─────────────────
model Espacio {
  id          String   @id @default(cuid())
  eventoId    String
  numero      String   // "22", "1M", "F-BANESI"...
  numerosAdicionales String[] @default([]) // otros números de stand que ocupa el mismo expositor, ej. Banco General en 100, 101 y 102
  nombre      String   // marca / expositor
  categoria   String   @default("AUTOMOTRIZ") // AUTOMOTRIZ | FINANCIERO
  fila        String?  // A-E, para la vista de retícula
  medidas     String?  // "15x20"
  areaM2      Float?
  alturaMaxCm Float    @default(550)
  autosEnPiso Int?

  estado      String   @default("SIN_RENDER") // SIN_RENDER|EN_REVISION|APROBADO|EN_FABRICACION|MONTADO|VERIFICADO

  x           Float?   // posición en el plano, % del ancho
  y           Float?   // posición en el plano, % del alto

  renderUrl   String?  // imagen de referencia (render aprobado) para comparar vs. obra

  personaContacto  String?
  telefonoContacto String?
  correoContacto   String?

  distribuidorId String?
  proveedorId     String?
  supervisorId    String? // Usuario (rol SUPERVISOR) a cargo de este stand

  fabricacionInicio DateTime?
  fabricacionFin    DateTime?
  montajeInicio     DateTime?
  montajeFin        DateTime?
  verificacionInicio DateTime?
  verificacionFin    DateTime?
  atrasadoMotivo     String?

  cargaElectricaKw Float?
  puntosLuz        String?
  usaRigging       Boolean?
  riggingPuntos    Int?
  pisoTarima       String?
  ultimaEntrega    DateTime?

  // ── Logística de montaje: equipo especial e internet ────────────
  manliftBrazo                 Boolean?
  manliftBrazoHorasMontaje     Float?
  manliftBrazoHorasDesmontaje  Float?
  montacargas                  Boolean?
  montacargasHorasMontaje      Float?
  montacargasHorasDesmontaje   Float?

  internet                 Boolean?
  internetWifi              Boolean?
  internetWifiMb            Int?     // 20 | 50 | 100 | 200
  internetCableado          Boolean?
  internetCableadoMb        Int?     // 10 | 20 | 30 | 50 | 100 | 200
  internetPortalCautivo     Boolean? // clave de wifi vía portal cautivo
  internetP2P               Boolean? // conexión p2p a redes sin internet, con proveedor
  internetSalidaAdicional   Boolean? // salida adicional cableado dedicado o p2p
  internetIpPublica         Boolean? // IP pública dedicada para usuario de VPN

  // ── Documentos de requerimientos (PDF/imagen subidos por el equipo) ──
  documentoInternetUrl     String?
  documentoMontacargasUrl  String?
  documentoVoltajeUrl      String?
  documentoRiggingUrl      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evento       Evento                @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  distribuidor Distribuidor?         @relation(fields: [distribuidorId], references: [id])
  proveedor    ProveedorConstructor? @relation(fields: [proveedorId], references: [id])
  supervisor   Usuario?              @relation("EspacioSupervisor", fields: [supervisorId], references: [id])

  etapas          EspacioEtapa[]
  versiones       VersionEntrega[]
  materiales      MaterialEspecificacion[]
  pins            Pin[]
  mediciones      Medicion[]
  incumplimientos Incumplimiento[]
  visitas         VisitaProgramada[]
  comentarios     ComentarioEspacio[]
  usuario         Usuario? @relation("EspacioUsuario")

  @@unique([eventoId, numero])
  @@map("espacios")
}

// ── Progreso por disciplina (Diseño, Estructura, Gráfica, Eléctrico) ─
model EspacioEtapa {
  id         String   @id @default(cuid())
  espacioId  String
  disciplina String   // DISENO | ESTRUCTURA | GRAFICA | ELECTRICO
  estado     String   @default("PENDIENTE") // PENDIENTE | AHORA | APROBADO
  detalle    String?
  fecha      DateTime?
  orden      Int      @default(0)

  espacio Espacio @relation(fields: [espacioId], references: [id], onDelete: Cascade)

  @@unique([espacioId, disciplina])
  @@map("espacio_etapas")
}

// ── Historial de versiones de render/plano (ficha de stand) ───────
// Flujo: el expositor sube v1 (render + plano). Mientras esté PENDIENTE
// no puede subir otra. Si se RECHAZA, puede subir la siguiente versión.
// Si se APRUEBA, ese espacio queda cerrado — no se pueden subir más
// versiones. revisadoPor/revisadoEn/comentario son el registro de
// auditoría de quién aprobó o rechazó y cuándo.
model VersionEntrega {
  id        String   @id @default(cuid())
  espacioId String
  version   String   // v1, v2, v3... (autogenerado)
  estado    String   @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA
  renderUrls String[] @default([]) // una o más imágenes/PDF del render
  mapaUrl    String?
  nota      String?  // nota del expositor al subir
  autor     String?  // nombre para mostrar (respaldo si no hay subidoPorId)
  fecha     DateTime @default(now())

  subidoPorId   String?
  revisadoPorId String?
  revisadoEn    DateTime?
  comentario    String? // motivo de rechazo / nota de aprobación

  espacio     Espacio  @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  subidoPor   Usuario? @relation("VersionSubidaPor", fields: [subidoPorId], references: [id])
  revisadoPor Usuario? @relation("VersionRevisadaPor", fields: [revisadoPorId], references: [id])

  @@map("versiones_entrega")
}

// ── Bitácora de comentarios del stand (cliente, ajustes, notas) ──
// Solo se agrega (no se edita ni se borra): es un historial con quién
// escribió cada comentario y cuándo.
model ComentarioEspacio {
  id        String   @id @default(cuid())
  espacioId String
  texto     String
  autorId   String?
  autor     String?  // nombre para mostrar (respaldo si no hay autorId)
  fecha     DateTime @default(now())

  espacio Espacio  @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [autorId], references: [id])

  @@map("comentarios_espacio")
}

// ── Checklist de materiales/acabados de la ficha de stand ─────────
model MaterialEspecificacion {
  id        String  @id @default(cuid())
  espacioId String
  elemento  String
  material  String?
  color     String?
  estado    String  @default("PENDIENTE") // CONFORME | EN_REVISION | NO_CONFORME | PENDIENTE
  orden     Int     @default(0)

  espacio Espacio @relation(fields: [espacioId], references: [id], onDelete: Cascade)

  @@map("materiales_especificacion")
}

// ── Pin sobre el render/foto para comparar render vs. obra ────────
model Pin {
  id        String  @id @default(cuid())
  espacioId String
  numero    Int
  x         Float   // % sobre la imagen de referencia
  y         Float
  elemento  String
  nota      String?
  fixNota   String?
  resuelto  Boolean @default(false)

  espacio    Espacio     @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  mediciones Medicion[]

  @@map("pins")
}

// ── Medición de obra: checklist con foto + medida, obligatorio ────
// Cuando valorMedido cae fuera de tolerancia, se crea automáticamente
// un Incumplimiento enlazado a esta medición.
model Medicion {
  id             String   @id @default(cuid())
  espacioId      String
  pinId          String?
  titulo         String
  especificacion String   // texto de la spec aprobada, ej. "500 cm alto"
  valorEsperado  Float?
  valorMedido    Float?
  unidad         String   @default("cm")
  toleranciaMas  Float    @default(0)
  toleranciaMenos Float   @default(0)
  conforme       Boolean?
  fotos          String   @default("[]") // JSON array de rutas /uploads/...
  registradoPorId String?
  createdAt      DateTime @default(now())

  espacio      Espacio        @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  pin          Pin?           @relation(fields: [pinId], references: [id])
  registradoPor Usuario?      @relation(fields: [registradoPorId], references: [id])
  incumplimiento Incumplimiento?

  @@map("mediciones")
}

// ── Reporte de incumplimiento / desviación ────────────────────────
model Incumplimiento {
  id             String    @id @default(cuid())
  espacioId      String
  medicionId     String?   @unique
  severidad      String    @default("MENOR") // CRITICA | MAYOR | MENOR
  titulo         String
  detalle        String?
  etapa          String?   // Diseño | Estructura | Gráfica | Eléctrico
  proveedorId    String?
  fechaLimite    DateTime?
  estado         String    @default("ABIERTA") // ABIERTA | EN_CORRECCION | CERRADA
  cerradoPorId   String?
  cerradoEn      DateTime?
  createdAt      DateTime  @default(now())

  espacio    Espacio               @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  medicion   Medicion?             @relation(fields: [medicionId], references: [id])
  proveedor  ProveedorConstructor? @relation(fields: [proveedorId], references: [id])
  cerradoPor Usuario?              @relation("IncumplimientoCerradoPor", fields: [cerradoPorId], references: [id])

  @@map("incumplimientos")
}

// ── Ruta de inspección del día (pantalla Obra) ────────────────────
model VisitaProgramada {
  id          String   @id @default(cuid())
  espacioId   String
  fecha       DateTime
  hora        String
  tarea       String
  estado      String   @default("PENDIENTE") // PENDIENTE | EN_CURSO | CERRADO
  asignadoAId String?
  orden       Int      @default(0)

  espacio   Espacio  @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  asignadoA Usuario? @relation(fields: [asignadoAId], references: [id])

  @@map("visitas_programadas")
}
