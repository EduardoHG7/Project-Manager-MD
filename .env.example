# Postgres. En Vercel, las integraciones "Vercel Postgres" y "Vercel Blob"
# inyectan estas variables automáticamente — no hace falta escribirlas a mano
# ahí. Para desarrollo local, corre `vercel env pull .env.local` después de
# conectar las integraciones (o apunta a tu propio Postgres).
POSTGRES_PRISMA_URL="postgresql://usuario:password@host:5432/motorshow?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://usuario:password@host:5432/motorshow"

# Vercel Blob — token de escritura para las fotos de evidencia.
# Sin esta variable, las fotos se guardan en public/uploads (solo sirve en
# local o en un servidor con disco propio, no en Vercel).
BLOB_READ_WRITE_TOKEN=""

# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-aleatorio"
NEXTAUTH_URL="http://localhost:3000"
